# PROJECT X runs on Robinhood Chain Mainnet (chain 4663) only.

# Recommended: Alchemy key (Robinhood's recommended RPC provider). Restrict it to your domains.
# Without it the public, rate-limited RPC https://rpc.mainnet.chain.robinhood.com is used.
NEXT_PUBLIC_ALCHEMY_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-only (never prefix with NEXT_PUBLIC_) ──
# Supabase project used for token logos, metadata JSON and the verified launch index.
# Apply supabase/migrations/0001_tokens.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional dedicated key for server-side verification RPC calls.
ALCHEMY_API_KEY=
